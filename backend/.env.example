# Default lokal: SQLite, Local authentication (HANYA development loopback)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5088
Database__Provider=Sqlite
ConnectionStrings__Sqlite=Data Source=Data/projectpulse.db
Security__Mode=Local

# Saat deploy ke server Development: ubah konfigurasi menjadi:
# Database__Provider=Postgres
# ConnectionStrings__Postgres=Host=HOST;Port=5432;Database=projectpulse;Username=projectpulse_app;Password=CHANGE_ME;SSL Mode=Require
# Security__Mode=Jwt
# Security__JwtAuthority=https://login.microsoftonline.com/TENANT_ID/v2.0
# Security__JwtAudience=api://APPLICATION_CLIENT_ID
# NOTE: konfigurasi Entra ID dan provisioning akun user tetap diperlukan.
